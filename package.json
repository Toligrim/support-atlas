{
  "name": "support-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "test": "npm run build && node tests/run-worker-tests.mjs",
    "db:migrate:local": "wrangler d1 migrations apply support-atlas-journal --local",
    "db:migrate:remote": "wrangler d1 migrations apply support-atlas-journal --remote",
    "secrets:setup": "node scripts/setup-secrets.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
